load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "acados_solver",
    srcs = glob(
        [
            "c_generated_code/*.c",
            "c_generated_code/*_model/*.c",
        ],
        exclude = ["c_generated_code/main*.c"],
    ),
    hdrs = glob([
        "c_generated_code/*.h",
        "c_generated_code/*_model/*.h",
    ]),
    includes = [
        "c_generated_code",
    ],
    copts = [
        "-O3",
        "-fPIC",
        "-std=c99",
    ],
    deps = [
        "//third_party/acados:acados",
    ],
)

# Native headless simulation benchmark executable
cc_binary(
    name = "mpc_sim",
    srcs = [
        "src/main_mpc.cpp",
        "src/acados_mpc_wrapper.hpp",
    ],
    copts = [
        "-std=c++17",
        "-O3",
    ],
    linkopts = [
        "-Wl,-rpath,/home/manuel/.local/lib/python3.10/site-packages/mujoco",
        "-Wl,-rpath,/home/manuel/software/acados/lib",
        "-pthread",
    ],
    deps = [
        ":acados_solver",
        "//third_party/mujoco:mujoco",
    ],
    data = [
        "CAD/scene.xml",
        "CAD/wavy_scene.xml",
        "CAD/robot.xml",
        "CAD/assets",
    ],
)

# C++ NMPC shared library for interactive GUI integration
cc_binary(
    name = "libbalancer_mpc.so",
    srcs = [
        "src/c_interface.cpp",
        "src/acados_mpc_wrapper.hpp",
    ],
    copts = [
        "-std=c++17",
        "-O3",
        "-fPIC",
    ],
    linkshared = True,
    linkopts = [
        "-Wl,-rpath,/home/manuel/software/acados/lib",
    ],
    deps = [
        ":acados_solver",
    ],
)

# Interactive GUI simulation target
cc_binary(
    name = "sim_gui",
    srcs = ["src/main_gui.cpp"],
    data = [
        ":libbalancer_mpc.so",
        ":libwbc.so",
        "run_interactive_sim.py",
        "CAD/scene.xml",
        "CAD/wavy_scene.xml",
        "CAD/robot.xml",
        "CAD/assets",
    ] + glob(["controllers/**"]),
)

# C++ whole-body controller (LQR-assisted QP, HPIPM) loaded by
# controllers/wbc/wbc_controller.py through ctypes. The controller core
# (wbc_core + rbd) has no MuJoCo dependency and no heap allocation; the same
# sources cross-compile for the STM32H743 (see embedded/). robot_model.h and
# wbc_default_params.h are generated by tools/gen_robot_model.py.
cc_library(
    name = "wbc_core",
    srcs = [
        "src/wbc/rbd.cpp",
        "src/wbc/wbc_core.cpp",
    ],
    hdrs = [
        "src/wbc/rbd.h",
        "src/wbc/robot_model.h",
        "src/wbc/wbc_core.h",
        "src/wbc/wbc_default_params.h",
        "src/wbc/wbc_params.h",
    ],
    copts = [
        "-std=c++17",
        "-O3",
        "-fPIC",
        "-Wall",
    ],
    strip_include_prefix = "src/wbc",
    deps = ["//third_party/acados:acados"],
)

cc_binary(
    name = "libwbc.so",
    srcs = ["src/wbc/wbc_capi.cpp"],
    copts = [
        "-std=c++17",
        "-O3",
        "-fPIC",
    ],
    linkshared = True,
    linkopts = ["-Wl,-rpath,/home/manuel/software/acados/lib"],
    deps = [":wbc_core"],
)

# Bazel test entry point for the whole-body-controller regression benchmark.
#   bazel test //:wbc_regression_test --test_output=all
cc_test(
    name = "wbc_regression_test",
    size = "medium",
    srcs = ["tests/wbc_regression_test.cpp"],
    data = [
        ":libwbc.so",
        "tests/wbc_benchmark.py",
        "tests/wbc_rbd_check.py",
        "CAD/scene.xml",
        "CAD/wavy_scene.xml",
        "CAD/robot.xml",
        "CAD/assets",
    ] + glob(["controllers/**/*.py"]),
    tags = ["local"],
)
